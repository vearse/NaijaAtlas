{
  "boundaries": {
    "name": "UN SALB Nigeria (OSGoF)",
    "url": "https://salb.un.org/en/data/nga",
    "usedFor": "State/LGA boundaries, land area (polygon area in compare pipeline)"
  },
  "hierarchy": {
    "name": "temikeezy/nigeria-geojson-data",
    "url": "https://github.com/temikeezy/nigeria-geojson-data",
    "license": "MIT",
    "usedFor": "State/LGA/ward hierarchy and ward counts"
  },
  "compare": {
    "manifest": "data/compare/manifest.json",
    "sourcesDir": "data/compare/sources/",
    "buildScript": "npm run build:compare",
    "verifyScript": "scripts/verify-compare.mjs"
  },
  "compareSources": {
    "populationDemographics": {
      "name": "NPC / NBS",
      "url": "https://www.nigerianstat.gov.ng/",
      "files": [
        "data/compare/sources/states-demographics-{period}.csv",
        "data/compare/sources/country-demographics-{period}.csv"
      ],
      "periods": ["2006", "2016", "2023"]
    },
    "economy": {
      "name": "NBS / BudgIT",
      "url": "https://yourbudgit.com/",
      "files": [
        "data/compare/sources/states-economy-{period}.csv",
        "data/compare/sources/country-economy-{period}.csv"
      ],
      "periods": ["2022", "2023", "2024"]
    },
    "governance": {
      "name": "INEC / NASS",
      "url": "https://www.inecnigeria.org/",
      "files": [
        "data/compare/sources/states-governance-{term}.csv",
        "data/compare/sources/states-senators-{term}.csv",
        "data/compare/sources/states-house-{term}.csv",
        "data/compare/sources/country-governance-{term}.csv"
      ],
      "terms": ["2019-2023", "2023-2027"]
    },
    "social": {
      "name": "NBS / NDHS",
      "url": "https://ng.ndhs.gov.ng/",
      "files": ["data/compare/sources/states-social-2021.csv"],
      "periods": ["2021"]
    },
    "general": {
      "name": "Curated / Wikipedia / state gov sites",
      "files": ["data/compare/sources/states-general.csv"]
    },
    "geography": {
      "name": "UN SALB + internal geo pipeline",
      "note": "Computed in build-compare.ts from public/geo/ and locations JSON — no CSV"
    }
  }
}
